# Variables de entorno del frontend. Copia este archivo como .env y ajusta los valores.
# Solo las que empiezan con VITE_ llegan al navegador: nunca pongas secretos aqui.

# Nombre que se muestra en la interfaz
VITE_APP_NOMBRE=Sistema de Vacaciones Hospitalarias

# URL base de la API (en desarrollo se reenvia al backend con el proxy de Vite)
VITE_API_URL=/api

# Tiempo en milisegundos que React Query considera frescos los datos antes de volver a pedirlos
VITE_CACHE_TIEMPO_MS=60000

# Solo desarrollo, no llega al navegador: direccion del backend para el proxy
DEV_PROXY_TARGET=http://localhost:3000