# Variables del servidor de produccion.
# NO se versiona el archivo .env: lo crea preparar.sh con claves aleatorias a partir de este modelo.

# Direccion interna con la que los equipos entran al sistema (IP o nombre) y su origen permitido por CORS.
# Si usas un puerto distinto de 443, agregalo al origen: https://192.168.1.50:8443
DIRECCION_INTERNA=__DIRECCION__
CORS_ORIGINS=https://__DIRECCION__

# Base de datos
DB_NAME=hbsa_vacaciones
DB_USER=hbsa_app
DB_PASSWORD=__DB_PASSWORD__
MYSQL_ROOT_PASSWORD=__MYSQL_ROOT_PASSWORD__

# Redis
REDIS_PASSWORD=__REDIS_PASSWORD__

# Sesiones (JWT)
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Reglas del negocio
ZONA_HORARIA_NEGOCIO=America/Guayaquil
DIAS_VACACIONES_ANUALES=30

# Registros y limites
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# Opcionales (descomenta solo si hace falta)
#BACKEND_IMAGE=hbsa-backend:local
#FRONTEND_IMAGE=hbsa-frontend:local
#PUERTO_HTTP=80
#PUERTO_HTTPS=443
# Carpeta de respaldos y copia fuera del servidor (rsync), por ejemplo usuario@equipo:/ruta
#RESPALDO_DIR=/var/respaldos/hbsa
#RESPALDO_COPIA_DESTINO=
