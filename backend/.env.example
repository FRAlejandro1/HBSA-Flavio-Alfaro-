# Variables de entorno del backend. Copia este archivo como .env y completa los valores.
# Nunca se sube .env al repositorio. config/env.ts valida todo esto al arrancar.

# Entorno de ejecucion: development, test o production
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Origenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:5173

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=hbsa_app
DB_PASSWORD=cambia-esta-clave
DB_NAME=hbsa_vacaciones
DB_POOL_LIMIT=10

# Redis: sesion y blacklist de jti, nunca datos sensibles
REDIS_URL=redis://localhost:6379

# JWT: secretos largos y distintos entre si (minimo 32 caracteres)
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso-de-32-caracteres
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh-de-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie del refresh token: true en produccion (requiere HTTPS)
COOKIE_SECURE=false

# Limite de peticiones por ventana de tiempo
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Dias de vacaciones laborables por periodo
DIAS_VACACIONES_ANUALES=30